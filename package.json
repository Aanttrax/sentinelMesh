{
  "name": "sentinelmesh",
  "private": true,
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "lint": "eslint 'apps/*/src/**/*.ts' 'libs/*/src/**/*.ts'",
    "lint:fix": "eslint 'apps/*/src/**/*.ts' 'libs/*/src/**/*.ts' --fix",
    "format": "prettier --check 'apps/*/src/**/*.ts' 'libs/*/src/**/*.ts'",
    "format:fix": "prettier --write 'apps/*/src/**/*.ts' 'libs/*/src/**/*.ts'",
    "test": "jest --passWithNoTests",
    "test:coverage": "jest --coverage --passWithNoTests",
    "build": "tsc -b",
    "clean": "tsc -b --clean"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@nestjs/testing": "^11.1.28",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.24.0",
    "jest": "^29.7.0",
    "prettier": "^3.5.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.30.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {}
}
